#!/usr/bin/env sh

# Skip local validation in CI/release automation to avoid duplicate build steps
# and Next.js lockfile collisions during GitHub Actions release pushes.
if [ "${CI:-}" = "true" ] || [ "${GITHUB_ACTIONS:-}" = "true" ] || [ "${HUSKY:-}" = "0" ]; then
  exit 0
fi

pnpm run format
pnpm run build
